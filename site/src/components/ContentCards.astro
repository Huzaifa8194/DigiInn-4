---
import BrandGraphic from './BrandGraphic.astro';
interface Card {
  title: string;
  category: string;
  summary: string;
  href: string;
  image?: string;
}

interface Props {
  id: string;
  kicker: string;
  title: string;
  entries: Card[];
  featured?: boolean;
  link?: { href: string; label: string };
}

const { id, kicker, title, entries, link, featured } = Astro.props;
---
<section class:list={["content-list", "paper", { "home-collection": featured }]} id={id} aria-labelledby={`${id}-title`}>
  <div class="content-list-heading">
    <div>
      <p class="section-kicker">{kicker}</p>
      <h2 id={`${id}-title`}>{title}</h2>
      {link && <a class="text-link dark-link" href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>}
    </div>
    <BrandGraphic motif={id === "selected-work" ? "window" : "signal"} />
  </div>
  <div class="content-grid">
    {entries.map(entry => (
      <article class="content-card">
        {entry.image && <div class="content-card-preview"><img src={entry.image} alt="" width="1440" height="960" loading="lazy" /><span class="preview-brand">DigiInn360</span></div>}
        <p class="section-kicker">{entry.category}</p>
        <h3><a href={entry.href}>{entry.title} <span aria-hidden="true">↗</span></a></h3>
        <p>{entry.summary}</p>
      </article>
    ))}
  </div>
</section>
