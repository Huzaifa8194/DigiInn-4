---
import Digi from './Digi.astro';
import type { ContentEntry } from '../data/digi-content';

interface Props {
  entry: ContentEntry;
  collection: 'projects' | 'blog';
}

const { entry, collection } = Astro.props;
---
<Digi title={`${entry.title} | DigiInn360`} description={entry.summary}>
  <section class="inner-hero">
    <a class="text-link" href={`/${collection}/`}>← {collection === 'projects' ? 'Selected Work' : 'Blog'}</a>
    <h1>{entry.title}</h1>
    <p>{entry.summary}</p>
  </section>
  <div class="entry-copy paper">
    {entry.sections.map(section => (
      <section>
        <h2>{section.heading}</h2>
        <p>{section.text}</p>
      </section>
    ))}
    <a class="text-link dark-link" href={collection === 'projects' ? '/contact/' : '/services/'}>{collection === 'projects' ? 'Discuss a similar project' : 'Explore our services'} <span aria-hidden="true">↗</span></a>
  </div>
</Digi>
