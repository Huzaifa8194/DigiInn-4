---
import BrandGraphic from '../components/BrandGraphic.astro';
import Digi from '../layouts/Digi.astro';
import ContentCards from '../components/ContentCards.astro';
import { postCards } from '../data/digi-content';
import { templates } from '../data/templates';

const chapters = [
  { label: '01 / ASSESS', title: 'We find the gaps.', text: 'DigiInn360 uses penetration testing and security audits to uncover weaknesses in your applications, endpoints and networks. We help you prioritize fixes based on what’s exposed.', code: 'AUDIT' },
  { label: '02 / DETECT', title: 'We spot threats early.', text: 'We monitor for suspicious activity across devices and networks so your team can investigate signs of compromise and respond quickly.', code: 'MONITOR' },
  { label: '03 / DEFEND', title: 'We protect every layer.', text: 'Firewall rules control traffic between systems. Endpoint protection helps contain malware, and encryption protects sensitive information in storage and in transit.', code: 'PROTECT' },
  { label: '04 / CONTROL ACCESS', title: 'We help you control access.', text: 'We help teams manage who can reach sensitive systems and train staff to recognize suspicious requests before sharing data or approving access.', code: 'VERIFY' },
  { label: '05 / BUILD & TRAIN', title: 'We build security in.', text: 'We develop websites, mobile apps and desktop software around your workflows. Our training helps the people who build and use those tools practice secure habits.', code: '360°' },
];
const services = [
{code:'DEFEND', title:'Cybersecurity', text:'Find the gaps. Strengthen your defenses. Protect the systems your business depends on.', items:['Threat detection & prevention','Endpoint & network security','Penetration testing & security audits','Data encryption & privacy'], id:'cybersecurity'},
{code:'BUILD', title:'Software development', text:'Purpose-built software for the way you work, with security considered from the first decision.', items:['Website development','Mobile applications','Desktop applications','Solutions tailored to your business'], id:'software'},
{code:'ENABLE', title:'Training & awareness', text:'Technology is only part of the picture. Give your people the knowledge to make better decisions.', items:['Cybersecurity awareness','Software development training','Security best practices','Tailored team training'], id:'training'}
];
---
<Digi>
<div class="security-story"><section class="hero">
<div class="hero-copy"><p class="meta"><span class="status-dot"></span> DigiInn360 · YOUR DIGITAL FUTURE</p><h1>Secure your world.<span class="muted-title">Build what’s next.</span></h1><p class="hero-lead">Cybersecurity. Software. Human expertise.<br/>A complete perspective on your digital world.</p><div class="actions"><a class="button" href="#services">Explore our expertise <span>↘</span></a><a class="text-link" href="#contact">Talk to an expert <span>↗</span></a></div></div>
<div class="hero-art">
  <div id="security-core" aria-label="Connected devices and servers surrounding a central security vault" role="img">
    <img class="core-fallback" src="/digiinn/security-core.webp" alt="" fetchpriority="high" />
  </div>
  <p class="hero-scene-caption"><span class="status-dot"></span> Security by design</p>
  <button id="motion-toggle" hidden type="button" aria-pressed="false" aria-label="Pause 3D animation">Ⅱ</button>
</div>
<div class="hero-bottom"><a href="#security-services">SCROLL TO EXPLORE <span>↓</span></a></div>
</section>
<div class="security-chapters" id="security-services">
  {chapters.map(chapter => (
    <article class="security-chapter">
      <p class="section-kicker">{chapter.label}</p>
      <h2>{chapter.title}</h2>
      <p>{chapter.text}</p>
      <div class="story-code" aria-hidden="true">{chapter.code}</div>
    </article>
  ))}
</div></div>
<nav class="expertise-strip" aria-label="Explore our expertise">
  <a href="#cybersecurity"><span>01 / PROTECT</span>Cybersecurity <b aria-hidden="true">↗</b></a>
  <a href="#software"><span>02 / CREATE</span>Software development <b aria-hidden="true">↗</b></a>
  <a href="#training"><span>03 / EMPOWER</span>Training &amp; awareness <b aria-hidden="true">↗</b></a>
</nav>

<section class="intro paper home-approach" id="approach">
  <div>
    <p class="section-kicker">THE 360° PERSPECTIVE</p>
    <h2>Progress needs <span>a secure foundation.</span></h2>
    <p class="home-lead">Your systems, your software and your people are connected. Your security should be, too.</p>
    <p class="home-support">We bring cybersecurity, software development and practical training together to help you move forward with confidence.</p>
    <a class="text-link dark-link" href="/about/">Meet DigiInn360 <span aria-hidden="true">↗</span></a>
  </div>
  <BrandGraphic motif="orbit" />
</section>

<section class="services paper home-services" id="services">
  <header class="home-scene-heading">
    <div>
      <p class="section-kicker">OUR EXPERTISE</p>
      <h2>Three disciplines.<br />One stronger business.</h2>
    </div>
    <BrandGraphic motif="layers" />
  </header>
  <div class="home-service-grid">
    {services.map(service => (
      <article class="home-service" id={service.id}>
        <p class="section-kicker">{service.code}</p>
        <h3>{service.title}</h3>
        <p>{service.text}</p>
        <ul>{service.items.map(item => <li>{item}</li>)}</ul>
        <a class="text-link dark-link" href={`/services/#${service.id}`}>Explore {service.title.toLowerCase()} <span aria-hidden="true">↗</span></a>
      </article>
    ))}
  </div>
</section>

<ContentCards featured id="selected-work" kicker="LIVE WEBSITE DEMOS" title="Selected Work" entries={templates.slice(0, 3)} link={{ href: '/projects/', label: 'View all templates' }} />

<section class="process home-process">
  <div class="process-heading">
    <p class="section-kicker">BUILT AROUND YOUR BUSINESS</p>
    <h2>See the whole picture.<br /><span>Act where it matters.</span></h2>
    <p>Good security starts with understanding what you need to protect. Here’s how we approach it.</p>
    <a class="text-link" href="#contact">Start a conversation <span aria-hidden="true">↗</span></a>
  </div>
  <BrandGraphic motif="signal" />
  <div class="process-steps">
    {[
      ['01', 'Understand', 'Your operations. Your systems. Your priorities. We start with the context behind the technology.'],
      ['02', 'Strengthen', 'Identify vulnerabilities, put the right controls in place and build solutions around your needs.'],
      ['03', 'Stay ready', 'Support your people with training and keep security part of the everyday conversation.'],
    ].map(([number, title, text]) => <div><span>{number}</span><h3>{title}</h3><p>{text}</p></div>)}
  </div>
</section>

<section class="faq paper home-faq">
  <div>
    <p class="section-kicker">A LITTLE CLARITY</p>
    <h2>Let’s make security less complicated.</h2>
  </div>
  <div class="faq-list">
    {[
      ['Where should we start with cybersecurity?', 'Start with what matters most: your critical systems, sensitive data and the people who use them. Talk to us about your current setup so we can discuss the right next steps.'],
      ['Can you help us build software as well?', 'Yes. DigiInn360 develops websites, mobile applications and desktop software tailored to business needs. We can discuss development and cybersecurity together.'],
      ['Do you offer training for our team?', 'Yes. We offer security awareness and software development training, including programs tailored to your team. Contact us to discuss the audience, topics and format.'],
    ].map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}
  </div>
  <BrandGraphic motif="message" />
</section>

<ContentCards featured id="latest-insights" kicker="FROM THE BLOG" title="Latest insights" entries={postCards.slice(0, 3)} link={{ href: '/blog/', label: 'Explore the blog' }} />

<section class="contact home-contact" id="contact">
  <div>
    <p class="section-kicker">LET’S START WITH A CONVERSATION</p>
    <h2>What’s next for<br />your business<span>?</span></h2>
    <div class="contact-bottom">
      <div>
        <span>EMAIL US</span>
        <a class="button" href="mailto:info@digiinn360.com">info@digiinn360.com <span aria-hidden="true">↗</span></a>
      </div>
      <div>
        <span>CALL US</span>
        <a href="tel:+92512748690">+92 51 2748690 ↗</a>
        <a href="tel:+923095624742">+92 309 5624742 ↗</a>
      </div>
    </div>
  </div>
  <BrandGraphic motif="network" />
</section>
<script>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) import('../motion/security-core').then(({initCore}) => initCore());</script>
</Digi>


