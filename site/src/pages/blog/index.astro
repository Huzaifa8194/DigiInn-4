import Digi from '../../layouts/Digi.astro';
import ContentCards from '../../components/ContentCards.astro';
import { postCards } from '../../data/digi-content';
---
<Digi title="DigiInn360 Blog | DigiInn360" description="Practical notes on cybersecurity, web development and the software behind everyday business operations.">
