---
import DigiEntry from '../../layouts/DigiEntry.astro';
import { projects } from '../../data/digi-content';

export function getStaticPaths() {
  return projects.map(entry => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
---
<DigiEntry entry={entry} collection="projects" />
