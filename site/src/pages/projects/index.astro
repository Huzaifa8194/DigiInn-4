---
import Digi from '../../layouts/Digi.astro';
import ContentCards from '../../components/ContentCards.astro';
import { templateCatalog, templates } from '../../data/templates';

const description = 'Explore live website and software demos for retail, food service, healthcare and operations.';
---
<Digi title="Selected Work | DigiInn360" description={description}>
  <section class="inner-hero">
    <p class="section-kicker">DIGIINN360 TEMPLATE COLLECTION</p>
    <h1>Selected Work</h1>
    <p>{description}</p>
  </section>
  <ContentCards
    id="selected-work"
    kicker="EXPLORE THE DEMOS"
    title="Website and software templates"
    entries={templates}
    link={{ href: templateCatalog, label: 'Open the original catalog' }}
  />
</Digi>
